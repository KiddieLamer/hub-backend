{
  "name": "hub-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "lint": "oxlint src/",
    "db:seed": "tsx src/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "bcryptjs": "^2.4.3",
    "drizzle-orm": "^0.38.0",
    "hono": "^4.7.0",
    "jose": "^6.0.0",
    "postgres": "^3.4.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.0.0",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.2",
    "drizzle-kit": "^0.30.0",
    "oxlint": "^0.15.0",
    "supertest": "^7.3.0",
    "tsx": "^4.19.0",
    "typescript": "~5.7.0",
    "vitest": "^5.0.2"
  }
}
